ENVIRONMENT="dev"

# --- Output ---
OUTPUT_DIR="documents"

# --- Message Broker ---
MESSAGE_BROKER_URL="amqp://guest:guest@localhost:5672/"
AI_FOUNDRY_QUEUE_NAME="ai_foundry_queue"

# --- SQL Server (same as main server) ---
SQL_SERVER="example.database.windows.net"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASS=""

# --- Azure Blob Storage (same as main server) ---
BLOB_CONNECTION_STR="DefaultEndpointsProtocol=https;AccountName=?;AccountKey=?;EndpointSuffix=?"
BLOB_STORAGE_CONTAINER_NAME=""

# --- Azure Document Intelligence (OCR) ---
AZURE_DOC_INTELLIGENCE_ENDPOINT="https://your-resource-name.cognitiveservices.azure.com/"
AZURE_DOC_INTELLIGENCE_KEY=""

# --- Azure OpenAI (Classification) ---
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1-mini"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
